                <ul>
                    <li>2015. június 4. - SOTE</li>
                    <li>2016. június 9. - Honvéd Kórház</li>
                    <li>2016. december 1. - SOTE</li>
                    <li>2017. június 22. - Szent Imre Egyetemi Oktatókórház</li>
                    <li>2018. április 11. – SOTE</li>
                </ul>
