@page "/tamas"

<PageTitle>Tirvol Tamás - Szakmai Profil</PageTitle>

<div class="page-container">
    <h1 class="main-title">Tirvol Tamás</h1>
    <p class="page-subtitle">Válasszon az alábbi szakmai területek közül a részletekért</p>

    <div class="profile-gallery">
        <!-- CV Card -->
        <a href="/tamas/Curriculumvitae" class="profile-card">
            <img src="https://placehold.co/400x500/3498db/ffffff?text=CV" alt="Önéletrajz" class="profile-image" />
            <div class="profile-name">
                <h2>Önéletrajz</h2>
            </div>
        </a>

        <!-- Eredmények Card -->
        <a href="/tamas/achievements" class="profile-card">
            <img src="https://placehold.co/400x500/2ecc71/ffffff?text=Eredmények" alt="Eredmények" class="profile-image" />
            <div class="profile-name">
                <h2>Eredmények</h2>
            </div>
        </a>

        <!-- Referenciák Card -->
        <a href="/tamas/references" class="profile-card">
            <img src="https://placehold.co/400x500/9b59b6/ffffff?text=Referenciák" alt="Referenciák" class="profile-image" />
            <div class="profile-name">
                <h2>Referenciák</h2>
            </div>
        </a>

        <!-- Társadalmi Aktivitás Card -->
        <a href="Tarsadalmiaktivitas" class="profile-card">
            <img src="https://placehold.co/400x500/f1c40f/ffffff?text=Társadalmi+Aktivitás" alt="Tarsadalmiaktivitas" class="profile-image" />
            <div class="profile-name">
                <h2>Társadalmi Aktivitás</h2>
            </div>
        </a>

        <!-- Blogok/Stories Card -->
        <a href="/tamas/blog" class="profile-card">
            <img src="https://placehold.co/400x500/e74c3c/ffffff?text=Blog" alt="Blogok és Történetek" class="profile-image" />
            <div class="profile-name">
                <h2>Blogok / Stories</h2>
            </div>
        </a>
    </div>

    <a href="/" class="back-link">&larr; Vissza a Főoldalra</a>
</div>

<style>
    .page-container {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
        padding: 2rem;
        text-align: center;
        background-color: #f7fafc;
        min-height: 100vh;
    }

    .main-title {
        color: #2d3748;
        margin-bottom: 0.5rem;
        font-size: 2.5rem;
        font-weight: 300;
    }

    .page-subtitle {
        color: #718096;
        margin-bottom: 2.5rem;
        font-size: 1.1rem;
    }

    .profile-gallery {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 2rem;
    }

    .profile-card {
        text-decoration: none;
        color: inherit;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
        transition: transform 0.3s ease-in-out, box-shadow 0.3s ease-in-out;
        position: relative;
        width: 280px; /* Adjusted width for 5 cards */
    }

        .profile-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        }

    .profile-image {
        width: 100%;
        height: auto;
        display: block;
    }

    .profile-name {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        background: linear-gradient(to top, rgba(0, 0, 0, 0.8), transparent);
        padding: 2rem 1rem 1rem;
        color: white;
    }

        .profile-name h2 {
            margin: 0;
            font-size: 1.5rem;
            font-weight: 500;
        }

    .back-link {
        display: inline-block;
        margin-top: 3rem;
        color: #4a5568;
        text-decoration: none;
        font-weight: 500;
    }

        .back-link:hover {
            text-decoration: underline;
        }
</style>

