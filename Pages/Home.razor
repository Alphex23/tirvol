@page "/"

<PageTitle>Our Family</PageTitle>

<div class="page-container">
    <h1 class="main-title">Choose a Profile</h1>
    <div class="profile-gallery">
        <!-- Tamás's Profile Link -->
        <a href="/tamas" class="profile-card">
            <img src="https://placehold.co/400x600/667eea/ffffff?text=Tirvol+Tamás" alt="Portrait of Tirvol Tamás" class="profile-image" />
            <div class="profile-name">
                <h2>Tirvol Tamás</h2>
            </div>
        </a>

        <!-- Ágnes's Profile Link -->
        <a href="/agnes" class="profile-card">
            <img src="https://placehold.co/400x600/ed64a6/ffffff?text=Tirvolné+Fekete+Ágnes" alt="Portrait of Tirvolné Fekete Ágnes" class="profile-image" />
            <div class="profile-name">
                <h2>Tirvolné Fekete Ágnes</h2>
            </div>
        </a>

        <!-- Csaba's Profile Link -->
        <a href="/csaba" class="profile-card">
            <img src="https://placehold.co/400x600/48bb78/ffffff?text=Tirvol+Csaba" alt="Portrait of Tirvol Csaba" class="profile-image" />
            <div class="profile-name">
                <h2>Tirvol Csaba</h2>
            </div>
        </a>

    </div>
</div>

<style>
    .page-container {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
        padding: 2rem;
        text-align: center;
        background-color: #f7fafc;
        min-height: 100vh;
    }

    .main-title {
        color: #2d3748;
        margin-bottom: 2.5rem;
        font-size: 2.5rem;
        font-weight: 300;
    }

    .profile-gallery {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 2rem;
    }

    .profile-card {
        text-decoration: none;
        color: inherit;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
        transition: transform 0.3s ease-in-out, box-shadow 0.3s ease-in-out;
        position: relative;
        width: 300px; /* Fixed width */
    }

    .profile-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    }

    .profile-image {
        width: 100%;
        height: auto;
        display: block;
    }

    .profile-name {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        background: linear-gradient(to top, rgba(0, 0, 0, 0.8), transparent);
        padding: 2rem 1rem 1rem;
        color: white;
    }

    .profile-name h2 {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 500;
    }
</style>
