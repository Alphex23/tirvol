@page "/kapcsolat"
@using System.ComponentModel.DataAnnotations

<PageTitle>Kapcsolat - Tirvol Consulting</PageTitle>

<section id="kapcsolat" class="py-20">
    <div class="container mx-auto px-6">
        <div class="max-w-2xl mx-auto bg-white p-8 sm:p-12 rounded-lg shadow-xl">
            <h2 class="text-3xl font-bold text-center mb-2">Lépjen velünk kapcsolatba!</h2>
            <p class="text-center text-gray-600 mb-8">Kérdése van? Írjon nekünk, és hamarosan válaszolunk!</p>

            <EditForm Model="@contactModel" OnValidSubmit="@HandleFormSubmit">
                <DataAnnotationsValidator />

                <div class="mb-5">
                    <label for="name" class="block mb-2 text-sm font-medium text-gray-900">Név</label>
                    <InputText id="name" @bind-Value="contactModel.Name" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" placeholder="Az Ön neve" />
                    <ValidationMessage For="@(() => contactModel.Name)" />
                </div>

                <div class="mb-5">
                    <label for="email" class="block mb-2 text-sm font-medium text-gray-900">Email cím</label>
                    <InputText id="email" @bind-Value="contactModel.Email" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" placeholder="email@cim.com" />
                    <ValidationMessage For="@(() => contactModel.Email)" />
                </div>

                <div class="mb-5">
                    <label for="message" class="block mb-2 text-sm font-medium text-gray-900">Üzenet</label>
                    <InputTextArea id="message" @bind-Value="contactModel.Message" rows="4" class="block p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-blue-500 focus:border-blue-500" placeholder="Írja le az üzenetét..." />
                    <ValidationMessage For="@(() => contactModel.Message)" />
                </div>

                <button type="submit" class="text-white bg-blue-600 hover:bg-blue-700 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm w-full sm:w-auto px-5 py-2.5 text-center">Üzenet küldése</button>
            </EditForm>

            @if (!string.IsNullOrEmpty(feedbackMessage))
            {
                <div class="mt-4 text-center @feedbackMessageColor">
                    @feedbackMessage
                </div>
            }
        </div>
    </div>
</section>

@code {
    private ContactFormModel contactModel = new();
    private string feedbackMessage = string.Empty;
    private string feedbackMessageColor = string.Empty;

    private async Task HandleFormSubmit()
    {
        feedbackMessageColor = "text-blue-500";
        feedbackMessage = "Küldés folyamatban...";

        // --- BACKEND INTEGRATION POINT ---
        // Here, you would use HttpClient to send the contactModel data
        // to your backend API (e.g., a Cloudflare Worker or an Azure Function)
        // that handles database insertion and sending the email.

        // Simulate a network delay
        await Task.Delay(1000);

        // This is a simulated response.
        bool isSuccess = true;

        if (isSuccess)
        {
            feedbackMessageColor = "text-green-500";
            feedbackMessage = "Köszönjük! Üzenetét sikeresen elküldtük.";
            contactModel = new(); // Clear the form
        }
        else
        {
            feedbackMessageColor = "text-red-500";
            feedbackMessage = "Hiba történt a küldés során. Kérjük, próbálja újra később.";
        }
    }

    public class ContactFormModel
    {
        [Required(ErrorMessage = "A név megadása kötelező.")]
        public string? Name { get; set; }

        [Required(ErrorMessage = "Az email cím megadása kötelező.")]
        [EmailAddress(ErrorMessage = "Érvénytelen email cím formátum.")]
        public string? Email { get; set; }

        [Required(ErrorMessage = "Az üzenet nem lehet üres.")]
        public string? Message { get; set; }
    }
}